# ===============================
# TourNest Server - Vercel Environment Variables
# ===============================
# Add these variables to your Vercel project settings
# Use: vercel env add <NAME> production --value "<VALUE>"

# ===============================
# Already Configured ✓
# ===============================
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/tournest
CLIENT_URL=https://your-frontend-domain.vercel.app
JWT_SECRET=your_super_secret_jwt_key

# ===============================
# Required Variables (Need to Add)
# ===============================

# Database Name
DB_NAME=tournest

# JWT Configuration
JWT_EXPIRES_IN=7d

# Firebase Admin Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"

# Rate Limiting (Optional - has defaults)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===============================
# Quick Add Commands
# ===============================
# Run these commands to add variables to Vercel:
#
# vercel env add DB_NAME production --value "tournest"
# vercel env add JWT_EXPIRES_IN production --value "7d"
# vercel env add FIREBASE_PROJECT_ID production --value "your_project_id"
# vercel env add FIREBASE_CLIENT_EMAIL production --value "your_client_email"
# vercel env add FIREBASE_PRIVATE_KEY production --value "-----BEGIN PRIVATE KEY-----\nYour_Key\n-----END PRIVATE KEY-----\n"
